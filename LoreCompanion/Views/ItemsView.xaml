<UserControl
    x:Class="LoreCompanion.Views.ItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:controls="clr-namespace:LoreCompanion.Views.Controls"
    xmlns:converters="clr-namespace:LoreCompanion.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ItemsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    Background="{StaticResource Brush.Background}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <converters:EditModeToDataTemplateConverter x:Key="Converter.ContentTemplate">
            <converters:EditModeToDataTemplateConverter.ReadOnlyTemplate>
                <DataTemplate DataType="{x:Type models:Item}">
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <Button
                                Margin="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                cm:Message.Attach="EditCurrentAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Edit}"
                                Visibility="{x:Static helpers:AdminHelper.AdminModeVisibility}" />
                            <TextBlock
                                helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                                helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                                helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                helpers:HighlightHelper.Text="{Binding Name}"
                                Style="{StaticResource Style.TextBlock.Heading.Large}" />
                        </DockPanel>
                        <Grid Margin="0,20,0,0" ColumnDefinitions="1* 2*">
                            <Border
                                Grid.Column="0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                BorderBrush="{StaticResource Brush.Border.Primary}"
                                BorderThickness="2">
                                <Image helpers:ImageHelper.ImageUrl="https://static0.fextralifeimages.com/file/eldenring/6/62/Secret_rite_scroll_info_item_elden_ring_shadow_of_the_erdtree_dlc_wiki_guide_200px.png" Stretch="Uniform" />
                            </Border>
                            <ScrollViewer
                                Grid.Column="1"
                                Margin="40,0,40,0"
                                VerticalScrollBarVisibility="Auto">
                                <TextBlock
                                    helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                                    helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                                    helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                    helpers:HighlightHelper.Text="{Binding Description, Converter={converters:QuoteConverter}}"
                                    Style="{StaticResource Style.TextBlock.Body.Quote}"
                                    TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </DataTemplate>
            </converters:EditModeToDataTemplateConverter.ReadOnlyTemplate>
            <converters:EditModeToDataTemplateConverter.EditTemplate>
                <DataTemplate DataType="{x:Type models:Item}">
                    <StackPanel>
                        <DockPanel>
                            <Button
                                Margin="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                cm:Message.Attach="SaveCurrentAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Save}" />
                            <Button
                                Margin="5"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                cm:Message.Attach="RollbackCurrentAsync"
                                DockPanel.Dock="Right"
                                Style="{StaticResource Style.Button.Cancel}" />
                            <TextBox MaxLength="128" Text="{Binding Name}" />
                        </DockPanel>
                        <TextBox
                            Margin="0,10"
                            MaxLength="2048"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </converters:EditModeToDataTemplateConverter.EditTemplate>
        </converters:EditModeToDataTemplateConverter>
    </UserControl.Resources>

    <controls:BusyDecorator IsBusy="{Binding IsBusy, Mode=OneWay}">
        <Grid ColumnDefinitions="4*, 5*">
            <Border
                Grid.Column="0"
                BorderBrush="{StaticResource Brush.Border.Primary}"
                BorderThickness="0,0,0.75,0">
                <DockPanel Margin="20">
                    <TextBox
                        DockPanel.Dock="Top"
                        Style="{StaticResource Style.TextBox.Search}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DockPanel
                        Height="40"
                        Margin="0,15,0,5"
                        DockPanel.Dock="Top">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            DockPanel.Dock="Left"
                            Style="{StaticResource Style.TextBlock.Heading}"
                            Text="Search Results" />
                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            cm:Message.Attach="CreateNewAsync"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Style.Button.New}"
                            Visibility="{x:Static helpers:AdminHelper.AdminModeVisibility}" />
                    </DockPanel>
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemsSource="{Binding ItemsView}"
                        SelectedItem="{Binding SelectedItem}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:Item}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <ContentControl
                Grid.Column="1"
                Margin="20"
                Content="{Binding SelectedItem}"
                ContentTemplate="{Binding EditMode, Mode=OneWay, Converter={StaticResource Converter.ContentTemplate}}" />
        </Grid>
    </controls:BusyDecorator>
</UserControl>