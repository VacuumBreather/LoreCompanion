<UserControl
    Background="{StaticResource Brush.Background}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d"
    x:Class="LoreCompanion.Views.ItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UniformGrid Columns="2">
        <DockPanel Margin="20">
            <TextBox DockPanel.Dock="Top" />
            <StackPanel>
                <TextBlock
                    Margin="0,5"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Search Results" />
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    x:Name="Items">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Item}">
                            <TextBlock
                                FontSize="16"
                                Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}"
                                Text="{Binding Name}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DockPanel>
        <DockPanel Margin="20">
            <UniformGrid
                DockPanel.Dock="Top"
                HorizontalAlignment="Right"
                Rows="1">
                <Button
                    Margin="5"
                    TextElement.Foreground="Black"
                    x:Name="CreateNew">
                    <Button.Content>
                        <TextBlock
                            FontSize="16"
                            Foreground="Black"
                            Text="New" />
                    </Button.Content>
                </Button>
                <Button
                    Margin="5"
                    TextElement.Foreground="Black"
                    x:Name="DeleteCurrent">
                    <Button.Content>
                        <TextBlock
                            FontSize="16"
                            Foreground="Black"
                            Text="Delete" />
                    </Button.Content>
                </Button>
                <Button
                    Margin="5"
                    TextElement.Foreground="Black"
                    x:Name="ToggleEdit">
                    <Button.Style>
                        <Style TargetType="{x:Type Button}">
                            <Setter Property="Content">
                                <Setter.Value>
                                    <TextBlock
                                        FontSize="16"
                                        Foreground="Black"
                                        Text="Edit" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DataContext.EditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static viewModels:EditMode.Editable}">
                                    <Setter Property="Content">
                                        <Setter.Value>
                                            <TextBlock
                                                FontSize="16"
                                                Foreground="Black"
                                                Text="Save" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </UniformGrid>
            <ContentControl x:Name="SelectedItem">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate DataType="{x:Type models:Item}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DataContext.EditMode, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="{x:Static viewModels:EditMode.Editable}">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate DataType="{x:Type models:Item}">
                                            <StackPanel>
                                                <TextBox Text="{Binding Name}" />
                                                <TextBox Text="{Binding Description}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>

                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </DockPanel>
    </UniformGrid>
</UserControl>