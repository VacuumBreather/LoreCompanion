<UserControl
    x:Class="LoreCompanion.Views.ItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:converters="clr-namespace:LoreCompanion.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:ItemsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    Background="{StaticResource Brush.Background}"
    mc:Ignorable="d">
    <UserControl.Resources>

        <converters:EditModeToDataTemplateConverter x:Key="Converter.ContentTemplate">
            <converters:EditModeToDataTemplateConverter.ReadOnlyTemplate>
                <DataTemplate DataType="{x:Type models:Item}">
                    <StackPanel cm:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                        <DockPanel>
                            <UniformGrid
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Rows="1">
                                <Button
                                    Margin="5"
                                    VerticalAlignment="Bottom"
                                    cm:Message.Attach="[Event Click] = [Action DeleteCurrentAsync]"
                                    Style="{StaticResource Style.Button.Delete}" />
                                <Button
                                    Margin="5"
                                    VerticalAlignment="Bottom"
                                    cm:Message.Attach="[Event Click] = [Action EditCurrentAsync]"
                                    Style="{StaticResource Style.Button.Edit}" />
                            </UniformGrid>
                            <TextBlock Style="{StaticResource Style.TextBlock.Heading.Large}" Text="{Binding Name}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </converters:EditModeToDataTemplateConverter.ReadOnlyTemplate>
            <converters:EditModeToDataTemplateConverter.EditTemplate>
                <DataTemplate DataType="{x:Type models:Item}">
                    <StackPanel cm:Action.TargetWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                        <DockPanel>
                            <UniformGrid
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"
                                Rows="1">
                                <Button
                                    Margin="5"
                                    VerticalAlignment="Bottom"
                                    cm:Message.Attach="[Event Click] = [Action DeleteCurrentAsync]"
                                    Style="{StaticResource Style.Button.Delete}" />
                                <Button
                                    Margin="5"
                                    VerticalAlignment="Bottom"
                                    cm:Message.Attach="[Event Click] = [Action SaveCurrentAsync]"
                                    Style="{StaticResource Style.Button.Save}" />
                            </UniformGrid>
                            <TextBox Text="{Binding Name}" />
                        </DockPanel>
                        <TextBox
                            Margin="0,10"
                            Text="{Binding Description}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </DataTemplate>
            </converters:EditModeToDataTemplateConverter.EditTemplate>
        </converters:EditModeToDataTemplateConverter>
    </UserControl.Resources>

    <UniformGrid Columns="2">
        <DockPanel Margin="20">
            <TextBox
                DockPanel.Dock="Top"
                Style="{StaticResource Style.TextBox.Search}"
                Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel>
                <DockPanel Margin="0,15,0,5">
                    <TextBlock
                        VerticalAlignment="Bottom"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Heading}"
                        Text="Search Results" />
                    <Button
                        x:Name="CreateNew"
                        Margin="5"
                        HorizontalAlignment="Right"
                        DockPanel.Dock="Right"
                        Style="{StaticResource Style.Button.New}" />
                </DockPanel>
                <ListBox
                    Background="Transparent"
                    BorderThickness="0"
                    ItemsSource="{Binding ItemsView}"
                    SelectedItem="{Binding SelectedItem}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:Item}">
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>
        </DockPanel>

        <DockPanel Margin="20">
            <ContentControl Content="{Binding SelectedItem}" ContentTemplate="{Binding EditMode, Mode=OneWay, Converter={StaticResource Converter.ContentTemplate}}">
                <ContentControl.Resources />
            </ContentControl>
        </DockPanel>
    </UniformGrid>
</UserControl>