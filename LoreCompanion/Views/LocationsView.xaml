<UserControl
    x:Class="LoreCompanion.Views.LocationsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    xmlns:views="clr-namespace:LoreCompanion.Views"
    d:DataContext="{d:DesignInstance viewModels:LocationsViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:EntityTemplateSelector
            x:Key="DataTemplateSelector.Related"
            CharacterTemplate="{StaticResource DataTemplate.Character.Related}"
            ItemTemplate="{StaticResource DataTemplate.Item.Related}" />
    </UserControl.Resources>

    <views:MasterDetailControl
        EditDetailTemplate="{StaticResource DataTemplate.Location.Detail.Edit}"
        EditMode="{Binding EditMode, Mode=OneWay}"
        ItemTemplate="{StaticResource DataTemplate.Location.Master}"
        ReadOnlyDetailTemplate="{StaticResource DataTemplate.Location.Detail.ReadOnly}"
        RelatedItemTemplateSelector="{StaticResource DataTemplateSelector.Related}"
        RelatedItemsSource="{Binding RelatedItems}" />

</UserControl>
