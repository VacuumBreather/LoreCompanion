<UserControl
    x:Class="LoreCompanion.Views.EpisodesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:LoreCompanion.Views.Behaviors"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:local="clr-namespace:LoreCompanion.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    d:DataContext="{d:DesignInstance viewModels:EpisodesViewModel,
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <!--  DataTemplate.Episode.Master  -->
        <DataTemplate x:Key="DataTemplate.Episode.Master" DataType="{x:Type models:Episode}">
            <DockPanel>
                <Image
                    Margin="0,5"
                    RenderOptions.BitmapScalingMode="Fant"
                    Stretch="Uniform">
                    <b:Interaction.Behaviors>
                        <behaviors:LoadCachedImageBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToThumbnailUrl}}" />
                    </b:Interaction.Behaviors>
                </Image>
                <TextBlock
                    Margin="20,0,0,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Body.Large}"
                    Text="{Binding Name}" />
            </DockPanel>
        </DataTemplate>

        <!--  DataTemplate.Episode.Detail  -->
        <DataTemplate x:Key="DataTemplate.Episode.Detail" DataType="{x:Type models:Episode}">
            <Grid cm:Bind.ModelWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                <!--  ReadOnly Template  -->
                <DockPanel Visibility="{Binding DataContext.EditMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource Converter.IsEqualToVisible}, ConverterParameter={x:Static viewModels:EditMode.ReadOnly}}">
                    <TextBlock
                        helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                        helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                        helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        helpers:HighlightHelper.Text="{Binding Name}"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Style.TextBlock.Heading.Large}" />
                    <TextBlock
                        Margin="0,15,0,0"
                        VerticalAlignment="Top"
                        DockPanel.Dock="Top"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">
                        <b:Interaction.Behaviors>
                            <behaviors:LoadCachedVideoTitleBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToMetadataUrl}}" />
                        </b:Interaction.Behaviors>
                    </TextBlock>
                    <Border
                        MaxWidth="320"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        BorderBrush="{StaticResource Brush.Border.Primary}"
                        BorderThickness="2"
                        DockPanel.Dock="Top">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform">
                            <b:Interaction.Behaviors>
                                <behaviors:LoadCachedImageBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToThumbnailUrl}}" />
                            </b:Interaction.Behaviors>
                        </Image>
                    </Border>
                    <Button
                        Width="100"
                        Height="67"
                        Margin="0,20,0,0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top"
                        cm:Message.Attach="PlayVideo($dataContext)"
                        DockPanel.Dock="Top"
                        Style="{StaticResource Style.Button.Play}" />
                </DockPanel>

                <!--  Edit Template  -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding DataContext.EditMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}, Converter={StaticResource Converter.IsEqualToVisible}, ConverterParameter={x:Static viewModels:EditMode.Edit}}">
                    <DockPanel>
                        <TextBox
                            helpers:TextBoxHelper.Header="Name"
                            DockPanel.Dock="Top"
                            MaxLength="128"
                            Style="{StaticResource Style.TextBox.Header}"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBox
                            helpers:TextBoxHelper.Header="Video Key"
                            DockPanel.Dock="Top"
                            MaxLength="11"
                            Style="{StaticResource Style.TextBox.Header}"
                            Text="{Binding VideoKey, UpdateSourceTrigger=PropertyChanged}" />
                    </DockPanel>
                </ScrollViewer>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <local:MasterDetailControl DetailTemplate="{StaticResource DataTemplate.Episode.Detail}" ItemTemplate="{StaticResource DataTemplate.Episode.Master}" />
</UserControl>
