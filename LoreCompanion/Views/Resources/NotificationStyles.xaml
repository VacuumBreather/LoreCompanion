<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:controls="clr-namespace:LoreCompanion.Views.Controls"
    xmlns:notifications="clr-namespace:LoreCompanion.ViewModels.Notifications">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ListBoxStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>


    <!--  DataTemplate.NotificationScreen.Implicit  -->
    <DataTemplate DataType="{x:Type notifications:NotificationScreen}">
        <Border
            Name="BackgroundBorder"
            MinHeight="75"
            Padding="25,15"
            Background="{StaticResource Brush.Background}"
            CornerRadius="4">
            <StackPanel HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock
                    Style="{StaticResource Style.TextBlock.Body.Large}"
                    Text="{Binding Title, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,5,0,0"
                    Text="{Binding Content, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="{x:Static notifications:NotificationType.Information}">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource Brush.Background.Button}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="{x:Static notifications:NotificationType.Success}">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource Brush.Background.Notification.Success}" />
                <Setter TargetName="BackgroundBorder" Property="TextElement.Foreground" Value="{StaticResource Brush.Foreground.Notification.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="{x:Static notifications:NotificationType.Warning}">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource Brush.Background.Notification.Warning}" />
                <Setter TargetName="BackgroundBorder" Property="TextElement.Foreground" Value="{StaticResource Brush.Foreground.Notification.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Type, Mode=OneWay}" Value="{x:Static notifications:NotificationType.Error}">
                <Setter TargetName="BackgroundBorder" Property="Background" Value="{StaticResource Brush.Background.Notification.Error}" />
                <Setter TargetName="BackgroundBorder" Property="TextElement.Foreground" Value="{StaticResource Brush.Foreground.Notification.Error}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!--  ControlTemplate.TransitionSubjectBase  -->
    <ControlTemplate x:Key="ControlTemplate.TransitionSubjectBase" TargetType="{x:Type controls:TransitionSubjectBase}">
        <Border
            x:Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}">
            <ContentPresenter
                x:Name="ContentPresenter"
                Content="{TemplateBinding ContentControl.Content}"
                ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}"
                RenderTransformOrigin=".5,.5">
                <ContentPresenter.RenderTransform>
                    <TransformGroup>
                        <MatrixTransform x:Name="PART_MatrixTransform" />
                        <RotateTransform x:Name="PART_RotateTransform" Angle="0" />
                        <ScaleTransform x:Name="PART_ScaleTransform" ScaleX="1" ScaleY="1" />
                        <SkewTransform x:Name="PART_SkewTransform" AngleX="0" AngleY="0" />
                        <TranslateTransform x:Name="PART_TranslateTransform" X="0" Y="0" />
                    </TransformGroup>
                </ContentPresenter.RenderTransform>
            </ContentPresenter>
        </Border>
    </ControlTemplate>

    <!--  Style.Button.CloseNotifications  -->
    <Style
        x:Key="Style.Button.CloseNotifications"
        BasedOn="{StaticResource Style.Button.TextBox.Clear}"
        TargetType="{x:Type Button}">
        <Setter Property="Width" Value="15" />
        <Setter Property="Height" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
    </Style>

    <!--  ControlTemplate.NotificationItem  -->
    <ControlTemplate x:Key="ControlTemplate.NotificationItem" TargetType="{x:Type controls:NotificationItem}">
        <Border
            x:Name="Border"
            Padding="{TemplateBinding Padding}"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding Border.CornerRadius}"
            RenderTransformOrigin=".5,.5">
            <Grid>
                <ContentPresenter
                    x:Name="ContentPresenter"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Content="{TemplateBinding ContentControl.Content}"
                    ContentStringFormat="{TemplateBinding ContentControl.ContentStringFormat}"
                    ContentTemplate="{TemplateBinding ContentControl.ContentTemplate}"
                    ContentTemplateSelector="{TemplateBinding ContentControl.ContentTemplateSelector}" />
                <Button
                    Margin="10"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    cm:Message.Attach="Close"
                    Style="{StaticResource Style.Button.CloseNotifications}" />
            </Grid>
            <Border.RenderTransform>
                <TransformGroup>
                    <MatrixTransform x:Name="PART_MatrixTransform" />
                    <RotateTransform x:Name="PART_RotateTransform" Angle="0" />
                    <ScaleTransform x:Name="PART_ScaleTransform" ScaleX="1" ScaleY="1" />
                    <SkewTransform x:Name="PART_SkewTransform" AngleX="0" AngleY="0" />
                    <TranslateTransform x:Name="PART_TranslateTransform" X="0" Y="0" />
                </TransformGroup>
            </Border.RenderTransform>
            <Border.LayoutTransform>
                <ScaleTransform x:Name="PART_LayoutScaleTransform" ScaleX="1" ScaleY="1" />
            </Border.LayoutTransform>
        </Border>
    </ControlTemplate>

    <!--  ControlTemplate.NotificationHost  -->
    <ControlTemplate x:Key="ControlTemplate.NotificationHost" TargetType="{x:Type controls:NotificationHost}">
        <DockPanel x:Name="PART_RootPanel">
            <controls:NotificationPanel
                x:Name="PART_ItemsPresenter"
                Margin="{TemplateBinding Padding}"
                IsItemsHost="True"
                MaxDisplayedElements="{TemplateBinding MaxDisplayedElements}"
                SeparatorBrush="Transparent"
                SeparatorMargin="0"
                SeparatorThickness="3" />
        </DockPanel>
    </ControlTemplate>

    <!--  Style.TransitionSubjectBase  -->
    <Style x:Key="Style.TransitionSubjectBase" TargetType="{x:Type controls:TransitionSubjectBase}">
        <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
        <Setter Property="Template" Value="{StaticResource ControlTemplate.TransitionSubjectBase}" />
    </Style>

    <!--  Style.TransitioningContentControl  -->
    <Style
        x:Key="Style.TransitioningContentControl"
        BasedOn="{StaticResource Style.TransitionSubjectBase}"
        TargetType="{x:Type controls:TransitioningContentControl}" />

    <!--  Style.NotificationItem  -->
    <Style
        x:Key="Style.NotificationItem"
        BasedOn="{StaticResource Style.TransitioningContentControl}"
        TargetType="{x:Type controls:NotificationItem}">
        <Setter Property="MaxWidth" Value="300" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Width" Value="300" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource CornerRadius.Controls}" />
        <Setter Property="TransitionEffect" Value="{controls:ZoomInTransition}" />
        <Setter Property="CloseTransitionEffect" Value="{controls:ShrinkOutTransition Duration='0:0:0.333'}" />
        <Setter Property="Template" Value="{StaticResource ControlTemplate.NotificationItem}" />
    </Style>

    <!--  Style.NotificationHost  -->
    <Style x:Key="Style.NotificationHost" TargetType="{x:Type controls:NotificationHost}">
        <Setter Property="ItemContainerStyle" Value="{StaticResource Style.NotificationItem}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="NotificationAlignment" Value="BottomRight" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Template" Value="{StaticResource ControlTemplate.NotificationHost}" />
    </Style>

    <!--  Style.TransitionSubjectBase.Implicit  -->
    <Style BasedOn="{StaticResource Style.TransitionSubjectBase}" TargetType="{x:Type controls:TransitionSubjectBase}" />

    <!--  Style.TransitioningContentControl.Implicit  -->
    <Style BasedOn="{StaticResource Style.TransitioningContentControl}" TargetType="{x:Type controls:TransitioningContentControl}" />

    <!--  Style.NotificationItem.Implicit  -->
    <Style BasedOn="{StaticResource Style.NotificationItem}" TargetType="{x:Type controls:NotificationItem}" />

    <!--  Style.NotificationHost.Implicit  -->
    <Style BasedOn="{StaticResource Style.NotificationHost}" TargetType="{x:Type controls:NotificationHost}" />

</ResourceDictionary>