<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:LoreCompanion.Views.Controls">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ProgressBarStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <BooleanToVisibilityConverter x:Key="Converter.BoolToVisibility" />

    <!--  Default DataTemplate for BusyContent when none is explicitly provided  -->
    <DataTemplate x:Key="ContentTemplate.BusyDecorator">
        <Border
            Padding="24,16"
            Background="{StaticResource Brush.Background.Panel}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            CornerRadius="8">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock
                    Margin="0,0,0,12"
                    HorizontalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Loading..." />
                <ProgressBar
                    Width="160"
                    Height="4"
                    IsIndeterminate="True" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!--  Style.BusyDecorator  -->
    <Style x:Key="Style.BusyDecorator" TargetType="{x:Type controls:BusyDecorator}">
        <Setter Property="OverlayBackgroundBrush" Value="{StaticResource Brush.Background.DialogHost}" />
        <Setter Property="BusyContentTemplate" Value="{StaticResource ContentTemplate.BusyDecorator}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyDecorator}">
                    <Grid>
                        <!--  Main Application Content  -->
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentStringFormat="{TemplateBinding ContentStringFormat}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />

                        <!--  Semi-Transparent Overlay (blocks input and displays indicator)  -->
                        <Grid
                            x:Name="PART_OverlayGrid"
                            Background="{TemplateBinding OverlayBackgroundBrush}"
                            IsHitTestVisible="{TemplateBinding IsBusy}"
                            Visibility="{TemplateBinding IsBusy,
                                                         Converter={StaticResource Converter.BoolToVisibility}}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding BusyContent}"
                                ContentTemplate="{TemplateBinding BusyContentTemplate}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style.BusyDecorator.Implicit  -->
    <Style BasedOn="{StaticResource Style.BusyDecorator}" TargetType="{x:Type controls:BusyDecorator}" />
</ResourceDictionary>