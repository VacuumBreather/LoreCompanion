    <!--  DataTemplate.Dialog.Master  -->
    <DataTemplate x:Key="DataTemplate.Dialog.Master" DataType="{x:Type models:Dialog}">
        <DockPanel>
            <DockPanel Width="{StaticResource Width.Image.MasterTemplate}" DockPanel.Dock="Left">
                <Image
