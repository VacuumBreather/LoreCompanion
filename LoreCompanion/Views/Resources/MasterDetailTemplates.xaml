<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:behaviors="clr-namespace:LoreCompanion.Views.Behaviors"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:converters="clr-namespace:LoreCompanion.Views.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:me="clr-namespace:LoreCompanion.Views.MarkupExtensions"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    mc:Ignorable="d">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="DialogStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Episode Templates  -->

    <!--  DataTemplate.Episode.Master  -->
    <DataTemplate x:Key="DataTemplate.Episode.Master" DataType="{x:Type models:Episode}">
        <DockPanel>
            <DockPanel Width="{StaticResource Width.Image.MasterTemplate}" DockPanel.Dock="Left">
                <Image
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="Fant"
                    Source="{StaticResource Image.Placeholder}"
                    Stretch="Uniform">
                    <b:Interaction.Behaviors>
                        <behaviors:LoadCachedImageBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToThumbnailUrl}}" />
                    </b:Interaction.Behaviors>
                </Image>
            </DockPanel>
            <iconPacks:PackIconMaterialDesign
                Width="20"
                Height="20"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{StaticResource Brush.Foreground.Primary}"
                Kind="LiveTv" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                Style="{StaticResource Style.TextBlock.Body.Large}"
                Text="{Binding Number, StringFormat='Episode {0}'}" />
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Episode.Detail.ReadOnly  -->
    <DataTemplate x:Key="DataTemplate.Episode.Detail.ReadOnly" DataType="{x:Type models:Episode}">
        <DockPanel cm:Bind.ModelWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <TextBlock
                helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                helpers:HighlightHelper.Text="{Binding Number, StringFormat='Episode {0}'}"
                DockPanel.Dock="Top"
                Style="{StaticResource Style.TextBlock.Heading.Large}" />
            <TextBlock
                Margin="0,15,0,0"
                VerticalAlignment="Top"
                DockPanel.Dock="Top"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap">
                <b:Interaction.Behaviors>
                    <behaviors:LoadCachedVideoTitleBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToMetadataUrl}}" />
                </b:Interaction.Behaviors>
            </TextBlock>
            <DockPanel HorizontalAlignment="Left" DockPanel.Dock="Top">
                <Border
                    MaxWidth="320"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource Brush.Border.Primary}"
                    BorderThickness="2"
                    DockPanel.Dock="Top">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{StaticResource Image.Placeholder}"
                        Stretch="Uniform">
                        <b:Interaction.Behaviors>
                            <behaviors:LoadCachedImageBehavior Url="{Binding VideoKey, Converter={StaticResource Converter.VideoKeyToThumbnailUrl}}" />
                        </b:Interaction.Behaviors>
                    </Image>
                </Border>
                <Button
                    Width="100"
                    Height="67"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    cm:Message.Attach="PlayVideo($dataContext)"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.Button.Play}" />
            </DockPanel>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Episode.Detail.Edit  -->
    <DataTemplate x:Key="DataTemplate.Episode.Detail.Edit" DataType="{x:Type models:Episode}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <TextBox
                    helpers:TextBoxHelper.Header="Number"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.TextBox.Header}">
                    <b:Interaction.Behaviors>
                        <behaviors:IntegerTextBoxBehavior Value="{Binding Number, UpdateSourceTrigger=PropertyChanged}" />
                    </b:Interaction.Behaviors>
                </TextBox>
                <TextBox
                    helpers:TextBoxHelper.Header="Video Key"
                    DockPanel.Dock="Top"
                    MaxLength="11"
                    Style="{StaticResource Style.TextBox.Header}"
                    Text="{Binding VideoKey, UpdateSourceTrigger=PropertyChanged}" />
            </DockPanel>
        </ScrollViewer>
    </DataTemplate>

    <!--  Location Templates  -->

    <!--  DataTemplate.Location.Master  -->
    <DataTemplate x:Key="DataTemplate.Location.Master" DataType="{x:Type models:Location}">
        <DockPanel>
            <DockPanel Width="{StaticResource Width.Image.MasterTemplate}" DockPanel.Dock="Left">
                <Image
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="Fant"
                    Source="{StaticResource Image.Placeholder}"
                    Stretch="Uniform">
                    <b:Interaction.Behaviors>
                        <behaviors:LoadCachedImageBehavior Url="{Binding ImageUrl}" />
                    </b:Interaction.Behaviors>
                </Image>
            </DockPanel>
            <iconPacks:PackIconRPGAwesome
                Width="20"
                Height="20"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{StaticResource Brush.Foreground.Primary}"
                Kind="Tower" />
            <TextBlock
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Style="{StaticResource Style.TextBlock.Body.Large}"
                Text="{Binding Name}" />
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Location.Detail.ReadOnly  -->
    <DataTemplate x:Key="DataTemplate.Location.Detail.ReadOnly" DataType="{x:Type models:Location}">
        <DockPanel cm:Bind.ModelWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <TextBlock
                helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                helpers:HighlightHelper.Text="{Binding Name}"
                DockPanel.Dock="Top"
                Style="{StaticResource Style.TextBlock.Heading.Large}" />
            <UniformGrid
                Margin="0,20,0,0"
                Columns="2"
                DockPanel.Dock="Top">
                <Border
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource Brush.Border.Primary}"
                    BorderThickness="2">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{StaticResource Image.Placeholder}"
                        Stretch="Uniform">
                        <b:Interaction.Behaviors>
                            <behaviors:LoadCachedImageBehavior Url="{Binding ImageUrl}" />
                        </b:Interaction.Behaviors>
                    </Image>
                </Border>
            </UniformGrid>
            <Separator VerticalAlignment="Top" DockPanel.Dock="Top" />
            <Grid
                VerticalAlignment="Top"
                ColumnDefinitions="150 20 *"
                DockPanel.Dock="Top">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Video" />
                <DockPanel Grid.Column="2">
                    <Button
                        VerticalAlignment="Center"
                        cm:Message.Attach="PlayVideo($dataContext)"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.Button.Play}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{Binding Episode.Number, StringFormat='Episode {0}', FallbackValue=''}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Timestamp, StringFormat='\\(hh\\:mm\\:ss\\)'}" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Location.Detail.Edit  -->
    <DataTemplate x:Key="DataTemplate.Location.Detail.Edit" DataType="{x:Type models:Location}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <TextBox
                    helpers:TextBoxHelper.Header="Name"
                    DockPanel.Dock="Top"
                    MaxLength="128"
                    Style="{StaticResource Style.TextBox.Header}"
                    Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap" />
                <TextBox
                    Margin="0,10"
                    helpers:TextBoxHelper.Header="Image Url"
                    DockPanel.Dock="Top"
                    MaxLength="512"
                    Style="{StaticResource Style.TextBox.Header}"
                    Text="{Binding ImageUrl, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap" />
                <ComboBox
                    Margin="0,10"
                    VerticalAlignment="Top"
                    helpers:ComboBoxHelper.ClearButtonVisibility="Visible"
                    helpers:ComboBoxHelper.Header="Episode"
                    DisplayMemberPath="Name"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataContext.Episodes, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    SelectedValue="{Binding EpisodeId}"
                    SelectedValuePath="Id"
                    Style="{StaticResource Style.ComboBox.Header}" />
                <TextBox
                    Margin="0,10"
                    helpers:TextBoxHelper.Header="Timestamp"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.TextBox.Header}">
                    <b:Interaction.Behaviors>
                        <behaviors:TimeTextBoxBehavior Value="{Binding Timestamp, UpdateSourceTrigger=PropertyChanged}" />
                    </b:Interaction.Behaviors>
                </TextBox>
            </DockPanel>
        </ScrollViewer>
    </DataTemplate>

    <!--  Item Templates  -->

    <!--  DataTemplate.Item.Master  -->
    <DataTemplate x:Key="DataTemplate.Item.Master" DataType="{x:Type models:Item}">
        <DockPanel>
            <DockPanel Width="{StaticResource Width.Image.MasterTemplate}" DockPanel.Dock="Left">
                <Image
                    Margin="0,5"
                    HorizontalAlignment="Center"
                    RenderOptions.BitmapScalingMode="Fant"
                    Source="{StaticResource Image.Placeholder}"
                    Stretch="Uniform">
                    <b:Interaction.Behaviors>
                        <behaviors:LoadCachedImageBehavior Url="{Binding ImageUrl}" />
                    </b:Interaction.Behaviors>
                </Image>
            </DockPanel>
            <iconPacks:PackIconRPGAwesome
                Width="20"
                Height="20"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{StaticResource Brush.Foreground.Primary}"
                Kind="{Binding Type, Converter={StaticResource Converter.ItemTypeToIcon}}" />
            <DockPanel Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Top"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.TextBlock.Body.Large}"
                    Text="{Binding Name}" />
                <DockPanel Margin="0,5,0,0" DockPanel.Dock="Top">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Type}" />
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text=" • " />
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Location.Name, FallbackValue='Unknown'}" />
                </DockPanel>
            </DockPanel>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Item.Detail.ReadOnly  -->
    <DataTemplate x:Key="DataTemplate.Item.Detail.ReadOnly" DataType="{x:Type models:Item}">
        <!--  ReadOnly Template  -->
        <DockPanel cm:Bind.ModelWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <TextBlock
                helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                helpers:HighlightHelper.Text="{Binding Name}"
                DockPanel.Dock="Top"
                Style="{StaticResource Style.TextBlock.Heading.Large}" />
            <Grid
                MaxHeight="250"
                Margin="0,20,0,0"
                ColumnDefinitions="200 *"
                DockPanel.Dock="Top">
                <Border
                    Grid.Column="0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource Brush.Border.Primary}"
                    BorderThickness="2">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{StaticResource Image.Placeholder}"
                        Stretch="Uniform">
                        <b:Interaction.Behaviors>
                            <behaviors:LoadCachedImageBehavior Url="{Binding ImageUrl}" />
                        </b:Interaction.Behaviors>
                    </Image>
                </Border>
                <ScrollViewer
                    Grid.Column="1"
                    MinHeight="220"
                    Margin="20,0,0,0"
                    Padding="0,0,5,0"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                        helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                        helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                        helpers:HighlightHelper.Text="{Binding Description, Converter={converters:QuoteConverter}}"
                        Style="{StaticResource Style.TextBlock.Body.Quote}"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
            <Separator VerticalAlignment="Top" DockPanel.Dock="Top" />
            <Grid
                VerticalAlignment="Top"
                ColumnDefinitions="150 20 *"
                RowDefinitions="50 50 50">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Type" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Type}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Found in" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Location.Name, FallbackValue='Unknown'}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Video" />
                <DockPanel Grid.Row="2" Grid.Column="2">
                    <Button
                        VerticalAlignment="Center"
                        cm:Message.Attach="PlayVideo($dataContext)"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.Button.Play}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{Binding Episode.Number, StringFormat='Episode {0}', FallbackValue=''}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Timestamp, StringFormat='\\(hh\\:mm\\:ss\\)'}" />
                </DockPanel>
            </Grid>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Item.Detail.Edit  -->
    <DataTemplate x:Key="DataTemplate.Item.Detail.Edit" DataType="{x:Type models:Item}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <TextBox
                    helpers:TextBoxHelper.Header="Name"
                    DockPanel.Dock="Top"
