                Height="20"
                Margin="20,0,0,0"
                VerticalAlignment="Center"
                DockPanel.Dock="Left"
                Foreground="{StaticResource Brush.Foreground.Primary}"
                Kind="Chat" />
            <DockPanel Margin="20,0,0,0" VerticalAlignment="Center">
                <TextBlock
                    VerticalAlignment="Top"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.TextBlock.Body.Large}"
                    Text="{Binding Character.Name, FallbackValue='Unknown'}" />
                <DockPanel Margin="0,5,0,0" DockPanel.Dock="Top">
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Location.Name, FallbackValue='Unknown'}" />
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text=" • " />
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Context}" />
                    <TextBlock
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text=" • " />
                    <TextBlock
                        MaxWidth="200"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Quote.Small}"
                        Text="{Binding Content}"
                        TextTrimming="WordEllipsis" />
                </DockPanel>
            </DockPanel>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Dialog.Detail.ReadOnly  -->
    <DataTemplate x:Key="DataTemplate.Dialog.Detail.ReadOnly" DataType="{x:Type models:Dialog}">
        <!--  ReadOnly Template  -->
        <DockPanel VerticalAlignment="Top" cm:Bind.ModelWithoutContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
            <TextBlock
                helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                helpers:HighlightHelper.Text="{Binding Character.Name, FallbackValue=''}"
                DockPanel.Dock="Top"
                Style="{StaticResource Style.TextBlock.Heading.Large}" />
            <UniformGrid
                Margin="0,20,0,0"
                Columns="2"
                DockPanel.Dock="Top">
                <Border
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource Brush.Border.Primary}"
                    BorderThickness="2">
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{StaticResource Image.Placeholder}"
                        Stretch="Uniform">
                        <b:Interaction.Behaviors>
                            <behaviors:LoadCachedImageBehavior Url="{Binding Character.ImageUrl, FallbackValue=''}" />
                        </b:Interaction.Behaviors>
                    </Image>
                </Border>
            </UniformGrid>
            <Separator VerticalAlignment="Top" DockPanel.Dock="Top" />
            <Grid
                VerticalAlignment="Top"
                ColumnDefinitions="150 20 *"
                DockPanel.Dock="Bottom"
                RowDefinitions="50 50 50">
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Heard when" />
                <TextBlock
                    Grid.Row="0"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Context}" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Heard in" />
                <TextBlock
                    Grid.Row="1"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Text="{Binding Location.Name, FallbackValue='Unknown'}" />
                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Style="{StaticResource Style.TextBlock.Heading}"
                    Text="Video" />
                <DockPanel Grid.Row="2" Grid.Column="2">
                    <Button
                        VerticalAlignment="Center"
                        cm:Message.Attach="PlayVideo($dataContext)"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.Button.Play}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Text="{Binding Episode.Number, StringFormat='Episode {0}', FallbackValue=''}" />
                    <TextBlock
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        DockPanel.Dock="Left"
                        Style="{StaticResource Style.TextBlock.Body.Small}"
                        Text="{Binding Timestamp, StringFormat='\\(hh\\:mm\\:ss\\)'}" />
                </DockPanel>
            </Grid>
            <Separator VerticalAlignment="Top" DockPanel.Dock="Bottom" />
            <ScrollViewer
                MinHeight="50"
                MaxHeight="300"
                Margin="20,0,0,0"
                Padding="0,0,5,0"
                VerticalAlignment="Top"
                VerticalScrollBarVisibility="Auto">
                <TextBlock
                    helpers:HighlightHelper.HighlightBrush="{StaticResource Brush.Background.Highlight}"
                    helpers:HighlightHelper.HighlightForegroundBrush="{StaticResource Brush.Foreground.Highlight}"
                    helpers:HighlightHelper.HighlightText="{Binding DataContext.SearchText, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    helpers:HighlightHelper.Text="{Binding Content, Converter={converters:QuoteConverter}}"
                    Style="{StaticResource Style.TextBlock.Body.Quote}"
                    TextWrapping="Wrap" />
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>

    <!--  DataTemplate.Dialog.Detail.Edit  -->
    <DataTemplate x:Key="DataTemplate.Dialog.Detail.Edit" DataType="{x:Type models:Dialog}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <DockPanel>
                <TextBox
                    helpers:TextBoxHelper.Header="Context"
                    DockPanel.Dock="Top"
                    MaxLength="128"
                    Style="{StaticResource Style.TextBox.Header}"
                    Text="{Binding Context, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="NoWrap" />
                <TextBox
                    Margin="0,10"
                    helpers:TextBoxHelper.Header="Description"
                    DockPanel.Dock="Top"
                    MaxLength="2048"
                    Style="{StaticResource Style.TextBox.Header}"
                    Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" />
                <ComboBox
                    Margin="0,10"
                    VerticalAlignment="Top"
                    helpers:ComboBoxHelper.ClearButtonVisibility="Visible"
                    helpers:ComboBoxHelper.Header="Character"
                    DisplayMemberPath="Name"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataContext.Characters, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    SelectedValue="{Binding CharacterId}"
                    SelectedValuePath="Id"
                    Style="{StaticResource Style.ComboBox.Header}" />
                <ComboBox
                    Margin="0,10"
                    VerticalAlignment="Top"
                    helpers:ComboBoxHelper.ClearButtonVisibility="Visible"
                    helpers:ComboBoxHelper.Header="Location"
                    DisplayMemberPath="Name"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataContext.Locations, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    SelectedValue="{Binding LocationId}"
                    SelectedValuePath="Id"
                    Style="{StaticResource Style.ComboBox.Header}" />
                <ComboBox
                    Margin="0,10"
                    VerticalAlignment="Top"
                    helpers:ComboBoxHelper.ClearButtonVisibility="Visible"
                    helpers:ComboBoxHelper.Header="Episode"
                    DisplayMemberPath="Name"
                    DockPanel.Dock="Top"
                    ItemsSource="{Binding DataContext.Episodes, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                    SelectedValue="{Binding EpisodeId}"
                    SelectedValuePath="Id"
                    Style="{StaticResource Style.ComboBox.Header}" />
                <TextBox
                    Margin="0,10"
                    helpers:TextBoxHelper.Header="Timestamp"
                    DockPanel.Dock="Top"
                    Style="{StaticResource Style.TextBox.Header}">
                    <b:Interaction.Behaviors>
                        <behaviors:TimeTextBoxBehavior Value="{Binding Timestamp, UpdateSourceTrigger=PropertyChanged}" />
                    </b:Interaction.Behaviors>
                </TextBox>
            </DockPanel>
        </ScrollViewer>
    </DataTemplate>

</ResourceDictionary>