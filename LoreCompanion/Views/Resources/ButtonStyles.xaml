<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TextBlockStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--  Style.Button  -->
    <Style x:Key="Style.Button" TargetType="{x:Type Button}">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="{StaticResource Brush.Background.Button}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Button}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border.Primary}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="{StaticResource CornerRadius.Controls}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock
                        Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Button}}}"
                        Style="{StaticResource Style.TextBlock.Label}"
                        Text="{Binding}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border
                        x:Name="ContentContainer"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding Border.CornerRadius}"
                        SnapsToDevicePixels="true">
                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Background" Value="{StaticResource Brush.Background.Button.Pressed}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{StaticResource Brush.Background.Button.MouseOver}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{StaticResource Brush.Background.Button.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--  Style.Button.New  -->
    <Style
        x:Key="Style.Button.New"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterialDesign Kind="Add" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style.Button.Delete  -->
    <Style
        x:Key="Style.Button.Delete"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterialDesign Kind="Delete" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style.Button.Edit  -->
    <Style
        x:Key="Style.Button.Edit"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterialDesign Kind="Edit" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style.Button.Save  -->
    <Style
        x:Key="Style.Button.Save"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterialDesign Kind="Save" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Style.Button.TextBox.Clear  -->
    <Style
        x:Key="Style.Button.TextBox.Clear"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterialDesign Kind="Close" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Pressed}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.MouseOver}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Pressed}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--  Style.Button.Implicit  -->
    <Style BasedOn="{StaticResource Style.Button}" TargetType="{x:Type Button}" />
</ResourceDictionary>