    <!--  Style.Button.WindowMinimize  -->
    <Style
        x:Key="Style.Button.WindowMinimize"
        BasedOn="{StaticResource Style.Button}"
        TargetType="{x:Type Button}">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Foreground.Primary.Transparent}" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterial Kind="WindowMinimize" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Foreground" Value="{StaticResource Brush.Background.Button.Primary.Pressed}" />
                <Setter Property="Background" Value="{StaticResource Brush.Border.Primary}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Foreground" Value="{StaticResource Brush.Background.Button.Primary.MouseOver}" />
                <Setter Property="Background" Value="{StaticResource Brush.Border.Primary}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsPressed" Value="true" />
                    <Condition Property="IsMouseOver" Value="true" />
                </MultiTrigger.Conditions>
                <Setter Property="Foreground" Value="{StaticResource Brush.Background.Button.Primary.Pressed}" />
                <Setter Property="Background" Value="{StaticResource Brush.Border.Primary}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

    <!--  Style.Button.WindowMaximize  -->
    <Style
        x:Key="Style.Button.WindowMaximize"
        BasedOn="{StaticResource Style.Button.WindowMinimize}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterial Kind="WindowMaximize" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="{x:Static WindowState.Maximized}">
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <iconPacks:PackIconMaterial Kind="WindowRestore" />
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--  Style.Button.WindowClose  -->
    <Style
        x:Key="Style.Button.WindowClose"
        BasedOn="{StaticResource Style.Button.WindowMinimize}"
        TargetType="{x:Type Button}">
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <iconPacks:PackIconMaterial Kind="WindowClose" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

