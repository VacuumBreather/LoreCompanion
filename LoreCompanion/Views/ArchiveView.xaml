<UserControl
    x:Class="LoreCompanion.Views.ArchiveView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:LoreCompanion.Views"
    d:DesignHeight="300"
    d:DesignWidth="300"
    mc:Ignorable="d">
    <UserControl.Resources>
        <helpers:EntityTemplateSelector
            x:Key="DataTemplateSelector.Master"
            CharacterTemplate="{StaticResource DataTemplate.Character.Master}"
            DialogTemplate="{StaticResource DataTemplate.Dialog.Master}"
            EpisodeTemplate="{StaticResource DataTemplate.Episode.Master}"
            ItemTemplate="{StaticResource DataTemplate.Item.Master}"
            LocationTemplate="{StaticResource DataTemplate.Location.Master}" />

        <helpers:EntityTemplateSelector
            x:Key="DataTemplateSelector.Detail"
            CharacterTemplate="{StaticResource DataTemplate.Character.Detail.ReadOnly}"
            DialogTemplate="{StaticResource DataTemplate.Dialog.Detail.ReadOnly}"
            EpisodeTemplate="{StaticResource DataTemplate.Episode.Detail.ReadOnly}"
            ItemTemplate="{StaticResource DataTemplate.Item.Detail.ReadOnly}"
            LocationTemplate="{StaticResource DataTemplate.Location.Detail.ReadOnly}" />
    </UserControl.Resources>

    <views:MasterDetailControl
        DetailTemplateSelector="{StaticResource DataTemplateSelector.Detail}"
        EditMode="ReadOnly"
        ItemTemplateSelector="{StaticResource DataTemplateSelector.Master}" />
</UserControl>
