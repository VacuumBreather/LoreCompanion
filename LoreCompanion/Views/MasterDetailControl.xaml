<UserControl
    x:Class="LoreCompanion.Views.MasterDetailControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cm="http://caliburnmicro.com"
    xmlns:controls="clr-namespace:LoreCompanion.Views.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:helpers="clr-namespace:LoreCompanion.Views.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:LoreCompanion.Models"
    xmlns:utilities="clr-namespace:LoreCompanion.Utilities"
    xmlns:viewModels="clr-namespace:LoreCompanion.ViewModels"
    x:Name="Root"
    cm:Bind.Model="{Binding}"
    d:DataContext="{d:DesignInstance {x:Type viewModels:MasterDetailSectionScreen(models:EntityBase)},
                                     IsDesignTimeCreatable=False}"
    d:DesignHeight="600"
    d:DesignWidth="800"
    mc:Ignorable="d">

    <controls:BusyDecorator IsBusy="{Binding IsBusy, Mode=OneWay}">
        <Grid ColumnDefinitions="4*, 5*">
            <Border
                Grid.Column="0"
                BorderBrush="{StaticResource Brush.Border.Primary}"
                BorderThickness="0,0,0.75,0">
                <DockPanel Margin="20">
                    <TextBox
                        DockPanel.Dock="Top"
                        Style="{StaticResource Style.TextBox.Search}"
                        Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <DockPanel
                        Height="40"
                        Margin="0,15,0,5"
                        DockPanel.Dock="Top">
                        <TextBlock
                            VerticalAlignment="Bottom"
                            DockPanel.Dock="Left"
                            Style="{StaticResource Style.TextBlock.Heading}"
                            Text="Search Results" />
                        <Button
                            Margin="5"
                            HorizontalAlignment="Right"
                            cm:Message.Attach="CreateNewAsync"
                            DockPanel.Dock="Right"
                            Style="{StaticResource Style.Button.New}"
                            Visibility="{x:Static helpers:AdminHelper.AdminModeVisibility}" />
                    </DockPanel>
                    <ListBox
                        Background="Transparent"
                        BorderThickness="0"
                        ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
                        ItemsSource="{Binding ItemsView}"
                        SelectedItem="{Binding SelectedItem}" />
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1" Margin="20">
                <Button
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    cm:Message.Attach="SaveCurrentAsync"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Save}">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource Converter.Multi.BooleanAndToVisibility}">
                            <MultiBinding.Bindings>
                                <Binding
                                    Converter="{StaticResource Converter.IsEqual}"
                                    ConverterParameter="{x:Static viewModels:EditMode.Edit}"
                                    Path="EditMode" />
                                <Binding Source="{x:Static utilities:AppHelper.IsAdminMode}" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    cm:Message.Attach="RollbackCurrent"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Cancel}">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource Converter.Multi.BooleanAndToVisibility}">
                            <MultiBinding.Bindings>
                                <Binding
                                    Converter="{StaticResource Converter.IsEqual}"
                                    ConverterParameter="{x:Static viewModels:EditMode.Edit}"
                                    Path="EditMode" />
                                <Binding Source="{x:Static utilities:AppHelper.IsAdminMode}" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <Button
                    Margin="5"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    cm:Message.Attach="EditCurrentAsync"
                    DockPanel.Dock="Right"
                    Style="{StaticResource Style.Button.Edit}">
                    <Button.Visibility>
                        <MultiBinding Converter="{StaticResource Converter.Multi.BooleanAndToVisibility}">
                            <MultiBinding.Bindings>
                                <Binding
                                    Converter="{StaticResource Converter.IsEqual}"
                                    ConverterParameter="{x:Static viewModels:EditMode.ReadOnly}"
                                    Path="EditMode" />
                                <Binding Source="{x:Static utilities:AppHelper.IsAdminMode}" />
                            </MultiBinding.Bindings>
                        </MultiBinding>
                    </Button.Visibility>
                </Button>
                <ContentControl
                    Content="{Binding SelectedItem}"
                    ContentTemplate="{Binding DetailTemplate, ElementName=Root}"
                    Visibility="{Binding SelectedItem, Converter={StaticResource Converter.NullToCollapsed}}" />
            </DockPanel>
        </Grid>
    </controls:BusyDecorator>
</UserControl>
