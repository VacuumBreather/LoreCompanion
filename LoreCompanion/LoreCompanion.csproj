<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
    </PropertyGroup>

    <!-- Shader compilation -->
    <PropertyGroup>
        <FxCPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe</FxCPath>
    </PropertyGroup>

    <ItemGroup>
        <ShaderSource Include="Views\Resources\Shaders\TintShader.hlsl" />
    </ItemGroup>

    <Target Name="CompileShaders"
            BeforeTargets="BeforeBuild"
            Inputs="@(ShaderSource)"
            Outputs="$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps">

        <Message Importance="High"
                 Text="Compiling shader: @(ShaderSource)" />

        <Exec
            Command="&quot;$(FxCPath)&quot; /T ps_3_0 /E main /Fo &quot;$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps&quot; &quot;@(ShaderSource)&quot;" />

        <ItemGroup>
            <Resource Include="$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps" />
        </ItemGroup>

    </Target>

    <!-- Application resources -->
    <ItemGroup>
        <None Remove="Views\Resources\Fonts\CormorantGaramond-VariableFont.ttf"/>
        <Resource Include="Views\Resources\Fonts\CormorantGaramond-VariableFont.ttf"/>
        <None Remove="Views\Resources\Images\EldenRing.png"/>
        <Resource Include="Views\Resources\Images\EldenRing.png"/>
        <None Remove="Views\Resources\Images\FooterLandscape.png" />
        <Resource Include="Views\Resources\Images\FooterLandscape.png" />
        <None Remove="Views\Resources\Shaders\TintShader.ps" />
        <None Remove="Views\Resources\Images\NavigationLandscape.png" />
        <Resource Include="Views\Resources\Images\NavigationLandscape.png" />
    </ItemGroup>

    <!-- NuGet packages -->
    <ItemGroup>
        <PackageReference Include="Caliburn.Micro" Version="5.0.258"/>
        <PackageReference Include="MahApps.Metro.IconPacks.Core" Version="6.2.1" />
        <PackageReference Include="MahApps.Metro.IconPacks.MaterialDesign" Version="6.2.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageReference Include="R3" Version="1.3.1" />
        <PackageReference Include="R3Extensions.WPF" Version="1.3.1" />
        <PackageReference Include="Scrutor" Version="7.0.0"/>
    </ItemGroup>

    <!-- XAML -->
    <ItemGroup>
        <Page Update="Views\ShellView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
    </ItemGroup>

</Project>
