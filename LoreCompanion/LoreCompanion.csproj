<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
        <FileVersion>1.0.0.0</FileVersion>
        <NeutralLanguage>en-US</NeutralLanguage>
        <ApplicationIcon>Views\Resources\Icon\Icon.ico</ApplicationIcon>
        <Company>VacuumBreather</Company>
        <Product>Lore Companion</Product>
    </PropertyGroup>

    <!-- Shader compilation -->
    <PropertyGroup>
        <FxCPath>C:\Program Files (x86)\Windows Kits\10\bin\10.0.26100.0\x64\fxc.exe</FxCPath>
    </PropertyGroup>

    <ItemGroup>
        <ShaderSource Include="Views\Resources\Shaders\TintShader.hlsl" />
    </ItemGroup>

    <Target Name="CompileShaders"
            BeforeTargets="BeforeBuild"
            Inputs="@(ShaderSource)"
            Outputs="$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps">

        <Message Importance="High"
                 Text="Compiling shader: @(ShaderSource)" />

        <Exec
            Command="&quot;$(FxCPath)&quot; /T ps_3_0 /E main /Fo &quot;$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps&quot; &quot;@(ShaderSource)&quot;" />

        <ItemGroup>
            <Resource Include="$(MSBuildProjectDirectory)\Views\Resources\Shaders\TintShader.ps" />
        </ItemGroup>

    </Target>

    <!-- Application resources -->
    <ItemGroup>
        <None Remove="Views\Resources\Fonts\CormorantGaramond-VariableFont.ttf"/>
        <Resource Include="Views\Resources\Fonts\CormorantGaramond-VariableFont.ttf"/>
        <None Remove="Views\Resources\Images\EldenRing.png"/>
        <Resource Include="Views\Resources\Images\EldenRing.png"/>
        <None Remove="Views\Resources\Images\FooterLandscape.png" />
        <Resource Include="Views\Resources\Images\FooterLandscape.png" />
        <None Remove="Views\Resources\Shaders\TintShader.ps" />
        <None Remove="Views\Resources\Images\NavigationLandscape.png" />
        <Resource Include="Views\Resources\Images\NavigationLandscape.png" />
        <None Remove="Views\Resources\Fonts\CormorantGaramond-Italic-VariableFont.ttf" />
        <Resource Include="Views\Resources\Fonts\CormorantGaramond-Italic-VariableFont.ttf" />
        <None Remove="Views\Resources\Images\Placeholder.png" />
        <Resource Include="Views\Resources\Images\Placeholder.png" />
        <None Remove="Views\Resources\Images\Background.png" />
        <Resource Include="Views\Resources\Images\Background.png" />
    </ItemGroup>

    <!-- NuGet packages -->
    <ItemGroup>
        <PackageReference Include="Caliburn.Micro" Version="5.0.258"/>
        <PackageReference Include="MahApps.Metro.IconPacks" Version="6.2.1" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.12"/>
        <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
        <PackageReference Include="R3" Version="1.3.1" />
        <PackageReference Include="R3Extensions.WPF" Version="1.3.1" />
        <PackageReference Include="Scrutor" Version="7.0.0"/>
        <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
        <PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    </ItemGroup>

    <!-- XAML -->
    <ItemGroup>
        <Page Update="Views\ShellView.xaml">
            <Generator>MSBuild:Compile</Generator>
            <XamlRuntime>Wpf</XamlRuntime>
            <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\Resources\BusyDecoratorStyles.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>
        <Page Update="Views\ArchiveView.xaml">
          <Generator>MSBuild:Compile</Generator>
          <XamlRuntime>Wpf</XamlRuntime>
          <SubType>Designer</SubType>
        </Page>
    </ItemGroup>
    <ItemGroup>
      <Reference Include="JetBrains.Annotations">
        <HintPath>..\..\..\Program Files\JetBrains\Rider\r2r\2026.2.2R\9BD4705135A7811147968CDF3EC723E\JetBrains.Annotations.dll</HintPath>
      </Reference>
    </ItemGroup>
    <ItemGroup>
      <Folder Include="Migrations\" />
    </ItemGroup>

</Project>
